@inherits LayoutComponentBase

@* Proveedores de MudBlazor: tienen que estar una sola vez en el layout principal *@
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="AlternarMenu" />
        <MudText Typo="Typo.h6" Class="ml-2">Productos</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="menuAbierto" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">AplicacionProductos</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool menuAbierto = true;

    private void AlternarMenu() => menuAbierto = !menuAbierto;
}
