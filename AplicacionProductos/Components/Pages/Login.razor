@page "/login"
@inject AuthService Auth
@inject LogService LogApp
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Class="mb-3">Iniciar sesión</MudText>

<MudPaper Class="pa-4" Style="max-width:420px;">
    <MudTextField @bind-Value="usuario" Label="Usuario" Variant="Variant.Outlined" Immediate="true" Class="mb-3" />
    <MudTextField @bind-Value="password" Label="Contraseña" Variant="Variant.Outlined" Immediate="true"
                  InputType="InputType.Password" OnKeyDown="OnKeyDown" Class="mb-3" />

    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IniciarAsync" Disabled="cargando" FullWidth="true">
        @(cargando ? "Ingresando..." : "Ingresar")
    </MudButton>
    <MudButton Variant="Variant.Text" Href="@HrefRegistro" FullWidth="true" Class="mt-2">Crear cuenta de cliente</MudButton>
    <MudButton Variant="Variant.Text" Href="catalogo" FullWidth="true" Class="mt-1" StartIcon="@Icons.Material.Filled.Storefront">Ver el catálogo sin iniciar sesión</MudButton>
</MudPaper>

@code {
    // A donde volver despues de entrar (ej: /checkout cuando el carrito pide iniciar sesion). Se lee del query string a mano:
    // [SupplyParameterFromQuery] no esta garantizado en Blazor Hybrid.
    private string? Volver => System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["volver"];

    private string usuario = "";
    private string password = "";
    private string? error;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        if (Auth.EstaLogueado) Nav.NavigateTo(Destino);
    }

    private string HrefRegistro => string.IsNullOrEmpty(Volver) ? "registro" : $"registro?volver={Uri.EscapeDataString(Volver)}";

    // Solo rutas internas ("/algo"): nunca una URL externa que venga en el query string
    private string Destino => !string.IsNullOrEmpty(Volver) && Volver.StartsWith('/') && !Volver.StartsWith("//") ? Volver : "/";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await IniciarAsync();
    }

    private async Task IniciarAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(password))
        {
            error = "Completá usuario y contraseña.";
            return;
        }

        cargando = true;
        try
        {
            await Auth.LoginAsync(usuario.Trim(), password);
            Nav.NavigateTo(Destino);
        }
        catch (ApiException ex)
        {
            error = ex.Message;                       // credenciales mal, sin conexion, etc.
        }
        catch (Exception ex)
        {
            error = "Ocurrió un error inesperado.";
            LogApp.Reportar(ex, "Login");             // queda en LogErrores con Origen = "App"
        }
        finally
        {
            cargando = false;
        }
    }
}
